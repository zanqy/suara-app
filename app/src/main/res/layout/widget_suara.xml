<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/plex_regular"
            android:text="SPECTRUM"
            android:textColor="#7CE0B4"
            android:textSize="7sp"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_regular"
            android:text=""
            android:textColor="#9AA497"
            android:textSize="7sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/fraunces"
        android:text="Belum ada lagu"
        android:textColor="#F3F0E7"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="0.9" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:fontFamily="@font/dm_sans"
        android:text="Tap untuk membuka Suara"
        android:textColor="#9AA497"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/widget_spectrum"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="bottom|center_vertical"
        android:clipToPadding="false">

                <View
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_amber" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_mint" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="17dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="29dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_amber" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_mint" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="31dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="23dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_amber" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="15dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="27dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="18dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_mint" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="11dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_amber" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="21dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_mint" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="13dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_amber" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="17dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_mint" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom" android:layout_marginEnd="1dp"
                    android:background="@drawable/bar_coral" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bar_coral" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_ctl_bg"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_prev"
                android:contentDescription="Sebelumnya" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_play_bg"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="Putar" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_ctl_bg"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="Berikutnya" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_repeat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_ctl_bg"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_repeat"
                android:contentDescription="Ulangi" />

            <ImageButton
                android:id="@+id/widget_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_ctl_bg"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_favorite_border"
                android:contentDescription="Favorit" />

            <ImageButton
                android:id="@+id/widget_eq"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_ctl_bg"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_eq"
                android:contentDescription="Equalizer" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
